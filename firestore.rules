rules_version = '2';

// Server-owned data model:
// - companies/{slug}, founders/{id}: public projections are served by Next.js.
// - users/{uid}, profiles/goals/sources below users: private identity and resume data.
// - generatedMessages, contactEnrichmentJobs: private derived output.
// - apiQuota, apiLeases, resumeExtractionUsage: server admission/usage state.
// All reads and writes use the Admin SDK, whose authorization boundary is IAM
// plus the server handlers. The browser only uses Firebase Authentication.
// No direct client operation, including an authenticated owner's, is required.
// Keep new collections and nested paths denied until their access model is reviewed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
