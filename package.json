{
  "name": "founders-directory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "scrape:yc": "tsx scripts/scraper/yc.ts",
    "test:scraper": "tsx --test scripts/scraper/*.test.ts",
    "test:filters": "tsx --test src/lib/*filter*.test.ts src/lib/company-pagination.test.ts src/lib/directory-query.test.ts",
    "test:onboarding": "tsx --test src/lib/onboarding/*.test.ts",
    "test:onboarding:browser": "tsx --test scripts/onboarding/*.browser.test.ts",
    "test:filters:e2e": "tsx --test scripts/directory/filters.e2e.test.ts",
    "test:profile": "tsx --test scripts/profile-loading.test.tsx",
    "test:security": "tsx --test scripts/security/*.test.ts src/lib/enrichment-*.test.ts src/lib/observability.test.ts src/lib/rate-limit.test.ts src/lib/onboarding/messages.test.ts && node --test scripts/security/firewall-rules.test.mjs scripts/security/vercel-cli.test.mjs scripts/security/firewall-audit.test.mjs scripts/security/rollout-readiness.test.mjs",
    "directory:index": "tsx scripts/directory/rebuild-index.ts",
    "test:directory": "tsx --test src/lib/directory-*.test.ts src/lib/company-pagination.test.ts src/lib/company-submission.test.ts scripts/security/directory-api.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@google/genai": "^2.11.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/queue": "^0.8.0",
    "botid": "^1.5.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.61.0",
    "next": "^15.5.28",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.1.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.19.0",
    "eslint-config-next": "15.5.28",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "shadcn": "^4.22.1",
    "@eslint/eslintrc": "^3.3.5"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    },
    "jwks-rsa": {
      "jose": "5.10.0"
    },
    "next": {
      "postcss": "^8.5.23"
    },
    "@grpc/grpc-js": "^1.14.5"
  },
  "engines": {
    "node": ">=22"
  }
}
