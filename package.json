{
  "name": "founders-directory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "scrape:yc": "tsx scripts/scraper/yc.ts",
    "test:scraper": "tsx --test scripts/scraper/*.test.ts",
    "test:filters": "tsx --test src/lib/*filter*.test.ts src/lib/company-pagination.test.ts src/lib/directory-query.test.ts",
    "test:onboarding": "tsx --test src/lib/onboarding/*.test.ts",
    "test:onboarding:browser": "tsx --test scripts/onboarding/*.browser.test.ts",
    "test:filters:e2e": "tsx --test scripts/directory/filters.e2e.test.ts",
    "test:profile": "tsx --test scripts/profile-loading.test.tsx",
    "test:security": "tsx --test scripts/security/*.test.ts src/lib/enrichment-*.test.ts src/lib/rate-limit.test.ts src/lib/onboarding/messages.test.ts && node --test scripts/security/firewall-rules.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@google/genai": "^2.11.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/queue": "^0.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.16.0",
    "firebase-admin": "^12.0.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.24.0",
    "next": "^15.1.0",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.1.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.19.0",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  }
}
